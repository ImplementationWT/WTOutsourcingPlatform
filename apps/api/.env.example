# Solo nombres. Los valores van en .env (ignorado por git) o en el gestor de
# secretos del servidor. Nada de esto llega al frontend ni a los repos de cliente.

PORT=
NODE_ENV=
LOG_LEVEL=

# --- GitHub App ---------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Ruta al .pem de la GitHub App (no el contenido).
GITHUB_PRIVATE_KEY_PATH=
GITHUB_TEMPLATE_OWNER=
GITHUB_TEMPLATE_REPO=
GITHUB_TARGET_OWNER=

# --- MongoDB Atlas (Administration API, Service Account) -----------------------
# Project ID (24 hex) del proyecto que contiene el clúster compartido.
ATLAS_PROJECT_ID=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_CLUSTER_NAME=
# Solo el host SRV, sin esquema ni credenciales (p. ej. <cluster>.<id>.mongodb.net).
ATLAS_CLUSTER_SRV_HOST=

# --- Base administrativa de la plataforma --------------------------------------
# Usuario propio con readWrite solo sobre ADMIN_MONGODB_DB.
ADMIN_MONGODB_URI=
ADMIN_MONGODB_DB=

# --- Apps de clientes: https://<slug>.<APP_BASE_DOMAIN> -------------------------
APP_BASE_DOMAIN=

# --- Template (docs/TEMPLATE_CONTRACT.md) ------------------------------------------
# Versión exacta de package.json → template.version (por defecto 1.6.0).
TEMPLATE_VERSION=
# schemaVersion mínima que debe devolver /api/meta (por defecto 3, la de 1.4.0 a 1.6.0).
MIN_SCHEMA_VERSION=

# --- Contraseña inicial del admin de cada app -----------------------------------
# random (por defecto): se genera y se escribe INITIAL_ADMIN_PASSWORD. default: no se escribe.
INITIAL_ADMIN_MODE=
# Ruta al archivo con la clave de cifrado para la revelación única (no el contenido).
INITIAL_PASSWORD_KEY_PATH=

# Clave AES-256 (32 bytes en base64) del vault de cuentas por proyecto (Operativa).
# Sin ella, las rutas del vault responden 503 y el resto funciona.
# Genérala con: openssl rand -base64 32 > account-vault.key
ACCOUNT_VAULT_KEY_PATH=

# --- Integraciones de clientes (Monday.com…) --------------------------------------
# Ruta al archivo con la clave AES-256 (32 bytes en base64) que cifra las credenciales
# mientras se aprovisiona (no el contenido). Genérala con: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY_SECRET_REF=
# Ruta al archivo con la clave (32 bytes en base64) que cifra la clave SSH de cada servidor dado
# de alta desde Integraciones → Servidores. Sin ella, solo el servidor principal (DEPLOY_HOST…).
# Genérala con: openssl rand -base64 32 > server-keys.key
SERVER_KEYS_ENCRYPTION_KEY_SECRET_REF=
# Horas que una credencial puede esperar a escribirse en GitHub (por defecto 24).
INTEGRATION_SECRET_TTL_HOURS=

# --- AI Developer (Claude Managed Agents) ---------------------------------------
# Ruta al archivo con la clave de la API de la cuenta de Anthropic de la empresa (no el valor).
# Sin ella el AI Developer queda desactivado. El agente y su entorno se crean solos la primera vez.
ANTHROPIC_API_KEY_SECRET_REF=
# ID del workspace de Anthropic (wrkspc_…). Obligatorio si la clave no está ligada a un workspace
# (Anthropic lo exige en la cabecera anthropic-workspace-id); también enlaza las sesiones. Por defecto: default.
ANTHROPIC_WORKSPACE=
# Tope de gasto por sesión en USD a precio de lista (por defecto 10).
AI_SESSION_BUDGET_USD=

# --- Despliegue en el VPS compartido (docs/deployment.md) -------------------------
# Con false (por defecto) el trabajo termina tras los secrets.
DEPLOY_ENABLED=
# Obligatorias con DEPLOY_ENABLED=true:
DEPLOY_HOST=
DEPLOY_SSH_PORT=
# Línea known_hosts del VPS ("<host> ssh-ed25519 AAAA…"), verificada.
DEPLOY_HOST_KEY=
# Ruta a la clave privada del usuario provisioner (no el contenido).
PROVISIONER_SSH_KEY_SECRET_REF=
GHCR_ORG=
VPS_PUBLIC_IP=
# Solo pruebas: CA de staging de Let's Encrypt (el health check acepta su certificado).
ACME_CA=

# --- Panel de administración ---------------------------------------------------
PANEL_ADMIN_USERNAME=
# Genera el valor con: pnpm hash-password
PANEL_ADMIN_PASSWORD_HASH=
# 32+ caracteres aleatorios (p. ej. openssl rand -base64 48)
SESSION_SECRET=
